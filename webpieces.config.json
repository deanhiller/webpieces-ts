{
  "webpiecesConfigJsonDocumentation": ".webpieces/instruct-ai/webpieces.config-policy.md",
  "commands": {
    "pr-gate": {
      "mode": "ON",
      "buildCommand": "TS_NODE_PROJECT=tsconfig.base.json node -r @swc-node/register -r tsconfig-paths/register scripts/react-native-compat.ts --validate-targets && pnpm wp-ci --base=$(git merge-base origin/main HEAD)",
      "mergeMode": "NONE",
      "reviewerAgents": 1,
      "maxReviewerRounds": 2,
      "gateSalt": "1eaf975da170d130d5ec5693fb77b28f40202d430b5bccd44833a7ec13b0999b",
      "checklists": [
        {
          "id": "backwards-compat-reviewer",
          "doc": ".claude/review/backwards-compatibility.md",
          "patterns": [
            "packages/**",
            "libraries/apis/**",
            "**/*Api.ts",
            "webpieces.config.json"
          ],
          "required": true
        },
        {
          "id": "error-output-reviewer",
          "doc": ".claude/review/error-output.md",
          "patterns": [
            "packages/**"
          ],
          "required": true
        },
        {
          "id": "experiment-lifecycle-reviewer",
          "doc": ".claude/review/experiment-lifecycle.md",
          "patterns": [
            "packages/**",
            "webpieces.config.json",
            "CLAUDE.md",
            ".claude/rules/**"
          ],
          "required": true
        },
        {
          "id": "webpieces-config-defaults-reviewer",
          "doc": ".claude/review/webpieces-config-defaults.md",
          "patterns": [
            "packages/tooling/rules-config/**",
            "webpieces.config.json"
          ],
          "required": true
        },
        {
          "id": "ticket-required-reviewer",
          "doc": ".claude/review/ticket-required.md",
          "patterns": [
            "**",
            ".claude/**",
            ".github/**"
          ],
          "required": true
        }
      ],
      "gates": [
        {
          "name": "API Changed",
          "patterns": [
            "libraries/apis/**",
            "**/*Api.ts"
          ],
          "warningColor": "yellow"
        },
        {
          "name": "Config Files Changed",
          "patterns": [
            "**/package.json",
            "**/tsconfig*.json",
            "nx.json",
            "**/*.config.*"
          ],
          "warningColor": "yellow"
        },
        {
          "name": "Dependency Graph Changed",
          "patterns": [
            "architecture/dependencies.json"
          ],
          "warningColor": "yellow"
        },
        {
          "name": "Claude / Rules Changed",
          "patterns": [
            "**/CLAUDE.md",
            "**/claude.*.md",
            ".claude/**",
            "webpieces.config.json"
          ],
          "warningColor": "yellow"
        },
        {
          "name": "Package.json Changed",
          "patterns": [
            "**/package.json"
          ],
          "warningColor": "yellow",
          "disabled": true
        },
        {
          "name": "Other API Files Changed",
          "patterns": [
            "**/*Dto.ts"
          ],
          "warningColor": "yellow",
          "disabled": true
        },
        {
          "name": "Authentication Changed",
          "patterns": [
            "**/authentication.ts"
          ],
          "warningColor": "yellow",
          "disabled": true
        },
        {
          "name": "DB Schema Changed",
          "patterns": [
            "**/schema.prisma"
          ],
          "warningColor": "red",
          "disabled": true
        },
        {
          "name": "Migration Files",
          "patterns": [
            "**/migrations/**"
          ],
          "warningColor": "red",
          "disabled": true
        },
        {
          "name": "Firestore Schema Changed",
          "patterns": [
            "**/firestore*.ts"
          ],
          "warningColor": "yellow",
          "disabled": true
        }
      ]
    },
    "guardHints": {
      "prCreationOrPush": "pnpm wp-start-upsert-pr",
      "mergeInProgress": "pnpm wp-finish-upsert-pr"
    }
  },
  "excludePaths": [
    "repositories/**"
  ],
  "match-rules": [
    {
      "mode": "NEW_AND_MODIFIED_CODE",
      "turnOffRuleUntilEpoch": 0,
      "name": "no-fetch",
      "patterns": [
        "(?<![.\\w])fetch\\s*\\(",
        "\\baxios\\b",
        "\\bXMLHttpRequest\\b",
        "\\bnew\\s+Request\\s*\\(",
        "from\\s+['\"](node-fetch|got|undici)['\"]"
      ],
      "mainMessage": "Raw HTTP (fetch/axios/XMLHttpRequest/\u2026) bypasses contract-first development \u2014 the client and server stop sharing the same API contract/types. Generate a type-safe client from the contract instead:",
      "options": [
        "PREFERRED: generate a client from the API you want to call \u2014 server-side, inject ClientHttpFactory from '@webpieces/http-client-node' and call factory.createRpcClient(SomeApi, new ClientConfig('some-svc', ClientRole.SERVER)); in a browser, use ClientHttpBrowserFactory from '@webpieces/http-client-browser' with ClientRole.END_USER_CLIENT. Then: await client.someMethod(req);",
        "Reuse an existing API contract already defined in your repo (under libraries/apis/**) and generate its client the same way.",
        "For a truly external service, create a NEW API contract (a decorated abstract class) AND a NEW implementation that calls fetch behind that contract, under an allowlisted dir (libraries/apis-external/**). The contract stays the shared surface; fetch is an impl detail."
      ],
      "disableAllowed": true,
      "allowedPaths": [
        "packages/http/http-client-core/**",
        "packages/cloud/cloudtasks-client/**",
        "libraries/apis-external/**",
        "libraries/apis/external/**"
      ],
      "turnOffRuleWhileOnBranch": null
    },
    {
      "mode": "NEW_AND_MODIFIED_CODE",
      "turnOffRuleUntilEpoch": 0,
      "name": "no-global-providesingleton-in-packages",
      "patterns": [
        "@provideSingleton\\s*\\(",
        "@provideSingletonAs\\s*\\("
      ],
      "mainMessage": "Framework code in packages/** must use @provideFrameworkSingleton (a SEPARATE DI registry) so a client's buildProviderModule() never scoops up webpieces framework classes. Plain @provideSingleton is for apps/client code only. (Turn ON once the repo consumes a @webpieces release whose DI-graph analyzer understands provideFrameworkSingleton.)",
      "options": [
        "In a packages/** framework class, use @provideFrameworkSingleton() (self-bind) or @provideFrameworkSingletonAs(TOKEN) from @webpieces/core-context.",
        "WebpiecesRouter loads buildFrameworkModule() + buildProviderModule(); any embeddable WebpiecesRouteCreator user must also load buildFrameworkModule() to resolve framework filters."
      ],
      "disableAllowed": true,
      "allowedPaths": [
        "apps/**",
        "libraries/**",
        "packages/tooling/**",
        "packages/core/core-context/src/provide.ts"
      ],
      "turnOffRuleWhileOnBranch": null
    }
  ],
  "rulePacks": [
    {
      "config": ".webpieces-config/rules/code-rules.json",
      "package": "@webpieces/code-rules"
    },
    {
      "config": ".webpieces-config/rules/ai-hook-rules.json",
      "package": "@webpieces/ai-hook-rules"
    },
    {
      "config": ".webpieces-config/rules/agent-workflow-rules.json",
      "package": "@webpieces/agent-workflow-rules"
    },
    {
      "config": ".webpieces-config/rules/nx-webpieces-rules.json",
      "package": "@webpieces/nx-webpieces-rules"
    },
    {
      "config": ".webpieces-config/rules/local.json",
      "package": "./webpieces-rules/local-rules.ts"
    }
  ]
}
