    "commands": {
        "pr-gate": {
            "mode": "ON",
            "buildCommandWhy": "--base is the FORK POINT via $(git merge-base origin/main HEAD), NOT origin/main: basing on origin/main marks projects from other people's already-merged PRs as 'affected' (your branch still has their pre-merge versions), wasting rebuilds. The fork point scopes affected to only your branch's work. The $(...) resolves because the gate runs with shell:true.",
            "buildCommand": "pnpm nx affected --target=ci --base=$(git merge-base origin/main HEAD)",
            "mergeModeWhy": "AUTO because this repo has allow_auto_merge=true and WANTS wp-finish-upsert-pr to land PRs: only the --subject/--body-file it passes can put the PR title + the compact risk/flags body in main's history. A UI merge cannot — it is limited to squash_merge_commit_title/message, and this repo's squash_merge_commit_message is COMMIT_MESSAGES, so a hand merge would land the branch's raw commit messages instead. Repos whose policy is 'a human clicks merge' set NONE (and must set squash_merge_commit_title=PR_TITLE, or commits land as 'Squash merge of <branch>').",
            "mergeMode": "AUTO",
            "gateSalt": "1eaf975da170d130d5ec5693fb77b28f40202d430b5bccd44833a7ec13b0999b",
            "checklistsWhy": "backwards-compat-reviewer enforces this repo's INVERTED compatibility policy: a changed webpieces surface must make the OLD spelling stop compiling, with the error naming the new one. It is required because every consumer of these surfaces is a coding agent, and an agent picks whatever typechecks — a @deprecated tag is not part of the type, so a soft landing freezes callers instead of migrating them (issue #589: an agent wrote the widest auth grant onto an admin contract and asserted the framework had no role support). Patterns are deliberately COARSE — every framework package, every API contract, and the config itself — because the reviewer makes the content-level judgment by reading the diff.",
            "checklists": [
                {
                    "subagent": "backwards-compat-reviewer",
                    "doc": ".claude/review/backwards-compatibility.md",
                    "patterns": [
                        "packages/**",
                        "libraries/apis/**",
                        "**/*Api.ts",
                        "webpieces.config.json"
                    ],
                    "required": true
                }
            ],
            "gatesWhy": "warningColor (REQUIRED on every gate) = the dashboard color shown WHEN a gate's patterns match a changed file (green is implicit when nothing matches; warningColor is purely visual and never blocks the PR — only the build gate can). disabled:true gates are kept-in-file examples (JSON has no comments) other projects flip to false and tune; they are skipped on this repo.",
            "gates": [
                {
                    "name": "API Changed",
                    "patterns": [
                        "libraries/apis/**",
                        "**/*Api.ts"
                    ],
                    "warningColor": "yellow"
                },
                {
                    "name": "Config Files Changed",
                    "patterns": [
                        "**/package.json",
                        "**/tsconfig*.json",
                        "nx.json",
                        "**/*.config.*"
                    ],
                    "warningColor": "yellow"
                },
                {
                    "name": "Dependency Graph Changed",
                    "patterns": [
                        "architecture/dependencies.json"
                    ],
                    "warningColor": "yellow"
                },
                {
                    "name": "Claude / Rules Changed",
                    "patterns": [
                        "**/CLAUDE.md",
                        "**/claude.*.md",
                        ".claude/**",
                        "webpieces.config.json"
                    ],
                    "warningColor": "yellow"
                },
                {
                    "name": "Package.json Changed",
                    "patterns": [
                        "**/package.json"
                    ],
                    "warningColor": "yellow",
                    "disabled": true
                },
                {
                    "name": "Other API Files Changed",
                    "patterns": [
                        "**/*Dto.ts"
                    ],
                    "warningColor": "yellow",
                    "disabled": true
                },
                {
                    "name": "Authentication Changed",
                    "patterns": [
                        "**/authentication.ts"
                    ],
                    "warningColor": "yellow",
                    "disabled": true
                },
                {
                    "name": "DB Schema Changed",
                    "patterns": [
                        "**/schema.prisma"
                    ],
                    "warningColor": "red",
                    "disabled": true
                },
                {
                    "name": "Migration Files",
                    "patterns": [
                        "**/migrations/**"
                    ],
                    "warningColor": "red",
                    "disabled": true
                },
                {
                    "name": "Firestore Schema Changed",
                    "patterns": [
                        "**/firestore*.ts"
                    ],
                    "warningColor": "yellow",
                    "disabled": true
                }
            ]
        },
        "guardHintsWhy": "The command strings the bash guards print in their fix hints — each name binds to exactly one guard (prCreationOrPush -> pr-creation-or-push-guard, mergeInProgress -> merge-in-progress-guard). Rename a gated command here and every guard message follows. These were the flat commands.upsertPr / commands.mergeComplete keys, which are now RETIRED.",
        "guardHints": {
