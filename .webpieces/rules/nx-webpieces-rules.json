{
  "no-file-import-cycles": {
    "mode": "RUN_EVERY_TIME",
    "ignoreTypeOnly": false,
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "runtime-architecture": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "nx-wiring": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "di-graph": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "missing-design-annotation": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "validate-architecture-unchanged": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": "dean/987-mcp-retry-semantics"
  },
  "validate-no-architecture-cycles": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "validate-packagejson": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "validate-versions-locked": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "validate-eslint-sync": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "no-root-union-api-type": {
    "mode": "RUN_EVERY_TIME",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "api-rules-for-openapi": {
    "mode": "OFF",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "api-rules-for-mcp": {
    "mode": "OFF",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null
  },
  "api-lib-dependencies": {
    "mode": "OFF",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null,
    "apiLibPackages": [
      "@webpieces/core-util",
      "tslib"
    ],
    "apiClients": []
  },
  "api-lib-path": {
    "mode": "OFF",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null,
    "paths": [
      "apps/app-example/*-api/**",
      "libraries/apis/**"
    ]
  },
  "framework-folder": {
    "mode": "OFF",
    "turnOffRuleUntilEpoch": 0,
    "turnOffRuleWhileOnBranch": null,
    "entries": [
      {
        "paths": [
          "packages/**"
        ],
        "frameworkSets": [
          "node",
          "browser",
          "browser+node",
          "browser+node+react-native"
        ],
        "roles": [
          "lib",
          "designed-lib",
          "api-lib",
          "api-client"
        ]
      }
    ]
  }
}
