{
    "name": "legacy-server",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/app-example/legacy-server/src",
    "projectType": "application",
    "targets": {
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest run apps/app-example/legacy-server/"
            }
        },
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/app-example/legacy-server",
                "main": "apps/app-example/legacy-server/src/server.ts",
                "tsConfig": "apps/app-example/legacy-server/tsconfig.app.json",
                "assets": []
            }
        }
    },
    "tags": ["framework:express", "role:server", "webpieces", "product:platform"],
    "metadata": {
        "webpieces": {
            "serviceName": "legacy-server"
        }
    }
}
