{
    "openapi": "3.1.0",
    "info": {
        "title": "Lang API",
        "summary": "List a lesson's passages in reading order.",
        "version": "1.0.0",
        "description": "INTERNAL — service-to-service use only. This document lists every endpoint these services serve, including ones no customer is meant to see. It is not the customer contract and must never be handed to one.\n\nEvery route under `paths` states whether it is safe to retry, derived from the endpoint's\ndeclared side-effect contract. It covers routes only: a webhook is a call we send, and we\nretry its delivery ourselves, so a webhook carries no retry sentence.\n\n| declared operation | read-only | destructive | idempotent |\n|---|---|---|---|\n| read | yes | no | yes |\n| write-idempotent | no | yes | yes |\n| write | no | yes | no |"
    },
    "tags": [
        {
            "name": "Lessons",
            "description": "Lessons."
        }
    ],
    "paths": {
        "/lang/passages": {
            "post": {
                "operationId": "LangLessonApi_listPassages",
                "x-webpieces-authentication": [],
                "summary": "List passages",
                "description": "Lists a lesson's passages.\n\nSafe to retry: this operation is read-only and idempotent.\n\nTriggered by a direct call.",
                "tags": [
                    "Lessons"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "title": "PassageListRequest",
                                "description": "A request for one lesson's passages. Its base lives in ANOTHER package, and is flattened.",
                                "properties": {
                                    "lessonNumber": {
                                        "type": "number",
                                        "description": "The lesson, 1-100."
                                    },
                                    "lessonType": {
                                        "$ref": "@fixture/dtos-a/components.openapi.json#/components/schemas/LessonTypeDto",
                                        "description": "How the lesson is built."
                                    },
                                    "narrator": {
                                        "$ref": "@fixture/dtos-b/components.openapi.json#/components/schemas/SpeakerGenderDto",
                                        "description": "Only passages narrated as this gender."
                                    }
                                },
                                "required": [
                                    "lessonNumber",
                                    "lessonType"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Every passage of the lesson, in reading order, with its descriptions.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "title": "PassageListResponse",
                                    "description": "One lesson's passages.",
                                    "properties": {
                                        "passages": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "@fixture/dtos-a/components.openapi.json#/components/schemas/PassageItemDto"
                                            },
                                            "description": "Every passage, in reading order."
                                        },
                                        "descriptions": {
                                            "$ref": "#/components/schemas/LocalizedDescriptionsDto",
                                            "description": "This library's own descriptions of the lesson."
                                        },
                                        "translations": {
                                            "$ref": "@fixture/dtos-b/components.openapi.json#/components/schemas/LocalizedDescriptionsDto",
                                            "description": "The shared, per-language descriptions — a DIFFERENT type with the same name."
                                        }
                                    },
                                    "required": [
                                        "passages",
                                        "descriptions",
                                        "translations"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "LocalizedDescriptionsDto": {
                "type": "object",
                "description": "Descriptions of a lesson, by audience — lang-apis' OWN type of this name.",
                "properties": {
                    "learner": {
                        "type": "string",
                        "description": "What a learner reads."
                    },
                    "teacher": {
                        "type": "string",
                        "description": "What a teacher reads."
                    }
                },
                "required": [
                    "learner",
                    "teacher"
                ]
            }
        }
    }
}
