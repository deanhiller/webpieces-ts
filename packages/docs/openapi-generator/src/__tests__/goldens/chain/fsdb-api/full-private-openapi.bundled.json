{
    "openapi": "3.1.0",
    "info": {
        "title": "Fsdb API",
        "summary": "Read stored passages and where their descriptions live.",
        "version": "1.0.0",
        "description": "INTERNAL — service-to-service use only. This document lists every endpoint these services serve, including ones no customer is meant to see. It is not the customer contract and must never be handed to one.\n\nEvery route under `paths` states whether it is safe to retry, derived from the endpoint's\ndeclared side-effect contract. It covers routes only: a webhook is a call we send, and we\nretry its delivery ourselves, so a webhook carries no retry sentence.\n\n| declared operation | read-only | destructive | idempotent |\n|---|---|---|---|\n| read | yes | no | yes |\n| write-idempotent | no | yes | yes |\n| write | no | yes | no |"
    },
    "tags": [
        {
            "name": "Storage",
            "description": "Storage."
        }
    ],
    "paths": {
        "/fsdb/passage": {
            "post": {
                "operationId": "FsdbApi_readPassage",
                "x-webpieces-authentication": [],
                "summary": "Read a passage",
                "description": "Reads one stored passage.\n\nSafe to retry: this operation is read-only and idempotent.\n\nTriggered by a direct call.",
                "tags": [
                    "Storage"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "title": "StoredPassageRequest",
                                "description": "A stored passage lookup.",
                                "properties": {
                                    "passageId": {
                                        "type": "string",
                                        "description": "The passage's identifier."
                                    }
                                },
                                "required": [
                                    "passageId"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The passage and where its descriptions are stored.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "title": "StoredPassageResponse",
                                    "description": "A stored passage.",
                                    "properties": {
                                        "passage": {
                                            "$ref": "#/components/schemas/PassageItemDto",
                                            "description": "The passage, exactly as lang-apis publishes it."
                                        },
                                        "descriptions": {
                                            "$ref": "#/components/schemas/LocalizedDescriptionsDto",
                                            "description": "Where its descriptions are stored."
                                        }
                                    },
                                    "required": [
                                        "passage",
                                        "descriptions"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "LocalizedDescriptionsDto": {
                "type": "object",
                "description": "Descriptions as stored — fsdb-api's OWN type of this name, a third shape.",
                "properties": {
                    "key": {
                        "type": "string",
                        "description": "The storage key."
                    }
                },
                "required": [
                    "key"
                ]
            },
            "PassageItemDto": {
                "type": "object",
                "description": "One passage of a lesson.",
                "properties": {
                    "passageId": {
                        "type": "string",
                        "description": "The passage's identifier."
                    },
                    "voice": {
                        "$ref": "#/components/schemas/VoiceChoiceDto",
                        "description": "The voice it is read in."
                    },
                    "narrator": {
                        "$ref": "#/components/schemas/SpeakerGenderDto",
                        "description": "Who narrates it."
                    }
                },
                "required": [
                    "passageId",
                    "voice",
                    "narrator"
                ]
            },
            "SpeakerGenderDto": {
                "type": "string",
                "description": "The gender a voice speaks as.",
                "enum": [
                    "female",
                    "male"
                ]
            },
            "VoiceChoiceDto": {
                "type": "object",
                "description": "One voice a lesson can be read in.",
                "properties": {
                    "voiceId": {
                        "type": "string",
                        "description": "The voice's identifier."
                    },
                    "gender": {
                        "$ref": "#/components/schemas/SpeakerGenderDto",
                        "description": "Who the voice sounds like."
                    }
                },
                "required": [
                    "voiceId",
                    "gender"
                ]
            }
        }
    }
}
