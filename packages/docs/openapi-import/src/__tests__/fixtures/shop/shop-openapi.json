{
    "openapi": "3.0.1",
    "info": {
        "title": "Synthetic Shop API",
        "version": "1.0.0",
        "description": "A made-up vendor API for the importer's tests. It is not any real vendor."
    },
    "paths": {
        "/v1/shops/{shopId}/items": {
            "parameters": [
                { "name": "shopId", "in": "path", "required": true, "schema": { "type": "string" } }
            ],
            "get": {
                "operationId": "inventory.ListItems",
                "summary": "List the items in a shop",
                "description": "Returns one page of items. Supports `filter` repeated, e.g. filter=name=x&filter=price>2.\nUse an email like ops@shop.example and never close the comment */ early.",
                "parameters": [
                    { "name": "filter", "in": "query", "schema": { "type": "string" }, "description": "A filter expression; may repeat." },
                    { "name": "limit", "in": "query", "schema": { "type": "integer" } },
                    { "name": "tag", "in": "query", "schema": { "type": "array", "items": { "type": "string" } } },
                    { "name": "User-Agent", "in": "header", "required": true, "schema": { "type": "string" } }
                ],
                "responses": {
                    "200": {
                        "description": "One page of items.",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItemPage" } } }
                    }
                }
            },
            "post": {
                "operationId": "inventory.CreateItem",
                "summary": "Create an item",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } }
                },
                "responses": {
                    "201": {
                        "description": "The created item.",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } }
                    }
                }
            }
        },
        "/v1/shops/{shopId}/item_stocks/{itemId}": {
            "put": {
                "operationId": "inventory.UpdateItemStock",
                "parameters": [
                    { "name": "shopId", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["quantity"],
                                "properties": {
                                    "quantity": { "type": "number", "description": "Units on hand." },
                                    "warehouse": {
                                        "type": "object",
                                        "properties": { "code": { "type": "string" } }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": { "200": { "description": "Updated." } }
            }
        },
        "/v1/shops/{shopId}/orders/{orderId}": {
            "delete": {
                "operationId": "orders.DeleteOrder",
                "summary": "Delete an order",
                "parameters": [
                    { "name": "shopId", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "Deleted." } }
            },
            "patch": {
                "operationId": "orders.UpdateOrder",
                "summary": "Update an order",
                "parameters": [
                    { "name": "shopId", "in": "path", "required": true, "schema": { "type": "string" } },
                    { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "allOf": [
                                    { "$ref": "#/components/schemas/OrderBase" },
                                    { "type": "object", "properties": { "note": { "type": "string", "nullable": true } } }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The updated order.",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
                    }
                }
            }
        },
        "/v1/unused": {
            "get": {
                "operationId": "misc.Unused",
                "responses": {
                    "200": {
                        "description": "Never generated.",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NeverReached" } } }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Item": {
                "type": "object",
                "description": "One item for sale.",
                "required": ["id", "name"],
                "properties": {
                    "id": { "type": "string", "description": "The item id." },
                    "name": { "type": "string" },
                    "price": { "type": "integer", "description": "Price in cents." },
                    "state": { "type": "string", "enum": ["active", "in-review", "archived"] },
                    "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
                    "metadata": { "type": "object" },
                    "x-vendor-flag": { "type": "boolean" },
                    "category": { "$ref": "#/components/schemas/Category" }
                }
            },
            "Category": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "parent": { "$ref": "#/components/schemas/Category" }
                }
            },
            "ItemPage": {
                "type": "object",
                "properties": {
                    "elements": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } },
                    "href": { "type": "string" }
                }
            },
            "OrderBase": {
                "type": "object",
                "required": ["state"],
                "properties": {
                    "state": { "$ref": "#/components/schemas/OrderState" }
                }
            },
            "OrderState": {
                "type": "string",
                "description": "Where an order is.",
                "enum": ["open", "paid", "locked"]
            },
            "Order": {
                "allOf": [
                    { "$ref": "#/components/schemas/OrderBase" },
                    {
                        "type": "object",
                        "required": ["id"],
                        "properties": {
                            "id": { "type": "string" },
                            "payment": { "oneOf": [{ "$ref": "#/components/schemas/Card" }, { "$ref": "#/components/schemas/Cash" }] }
                        }
                    }
                ]
            },
            "Card": { "type": "object", "properties": { "last4": { "type": "string" } } },
            "Cash": { "type": "object", "properties": { "tendered": { "type": "number" } } },
            "NeverReached": { "type": "object", "properties": { "x": { "type": "string" } } }
        }
    }
}
