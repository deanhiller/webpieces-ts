{
    "openapi": "3.0.3",
    "info": {
        "title": "Mixed Dialect API",
        "version": "9.9.9",
        "description": "A document webpieces did **not** generate.\n\nIt is deliberately written in 3.0's dialect, with the reference shapes a 3.0 generator emits, so the renderer is exercised against a document whose only claim on it is conformance."
    },
    "servers": [{ "url": "https://mixed.example.com/", "description": "Production." }],
    "tags": [{ "name": "Trees", "description": "Self-referential shapes." }],
    "security": [{ "MixedKey": [] }],
    "paths": {
        "/trees/plant": {
            "post": {
                "operationId": "TreeApi_plantTree",
                "summary": "plantTree",
                "description": "Plants one tree.",
                "tags": ["Trees"],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/Category" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success.",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/Category" }
                            }
                        }
                    }
                }
            }
        },
        "/trees/count": {
            "get": {
                "operationId": "TreeApi_countTrees",
                "summary": "countTrees",
                "description": "Counts them. It carries no tag on purpose.",
                "security": [],
                "responses": { "204": { "description": "Counted." } }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "MixedKey": {
                "type": "apiKey",
                "in": "header",
                "name": "x-mixed-key",
                "description": "Your key."
            }
        },
        "schemas": {
            "Category": {
                "type": "object",
                "description": "A category that contains itself, which is what makes it a cycle test.",
                "properties": {
                    "name": { "type": "string", "description": "What it is called." },
                    "parent": {
                        "allOf": [{ "$ref": "#/components/schemas/Category" }],
                        "description": "The 3.0 wrapper shape: a description beside an allOf-of-one-ref."
                    },
                    "season": {
                        "anyOf": [{ "$ref": "#/components/schemas/Season" }, { "type": "null" }],
                        "description": "The 3.1 nullable-reference shape."
                    },
                    "planted": {
                        "type": "string",
                        "format": "date",
                        "description": "A format, which renders inside angle brackets."
                    },
                    "retiredAt": {
                        "type": ["string", "null"],
                        "format": "date-time",
                        "description": "Nullable: the type column shows the NON-null type."
                    },
                    "ghost": {
                        "$ref": "#/components/schemas/NotDefinedAnywhere",
                        "description": "A reference the document never defines."
                    }
                },
                "required": ["name"]
            },
            "Season": {
                "type": "string",
                "description": "A named enum. It stays inline rather than getting a page of its own.",
                "enum": ["spring", "summer", "autumn", "winter"]
            }
        }
    }
}
