{
    "name": "@webpieces/ai-hook-rules",
    "version": "0.0.0-dev",
    "description": "Independent source edit rules and source hook for AI coding agents.",
    "type": "commonjs",
    "main": "./src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./package.json": "./package.json",
        "./claude-code-rules": "./src/adapters/rules-hook.js"
    },
    "files": [
        "src/**/*",
        "README.md"
    ],
    "author": "Dean Hiller",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/deanhiller/webpieces-ts.git",
        "directory": "packages/tooling/ai-hook-rules"
    },
    "dependencies": {
        "@webpieces/hook-runtime": "workspace:*",
        "@webpieces/rules-config": "workspace:*",
        "inversify": "7.10.4",
        "reflect-metadata": "0.2.2",
        "@webpieces/tooling-common": "workspace:*"
    },
    "publishConfig": {
        "access": "public",
        "bin": {
            "wp-ai-rules-hook": "./src/adapters/rules-hook.js"
        }
    }
