{
    "name": "@webpieces/nx-webpieces-rules",
    "version": "0.0.0-dev",
    "description": "Nx-specific webpieces validation rules, graph tooling, executors, and inference plugin.",
    "type": "commonjs",
    "main": "./src/index.js",
    "executors": "./executors.json",
    "exports": {
        ".": "./src/index.js",
        "./package.json": "./package.json",
        "./plugin": "./src/plugin.js",
        "./executors.json": "./executors.json",
        "./rule-pack": "./src/rule-pack.js",
        "./rule-runtime": "./src/rule-runtime.js"
    },
    "files": [
        "src/**/*",
        "templates/**/*",
        "executors.json",
        "README.md"
    ],
    "dependencies": {
        "@webpieces/api-doc-model": "workspace:*",
        "@webpieces/core-util": "workspace:*",
        "@webpieces/eslint-rules": "workspace:*",
        "@webpieces/rules-config": "workspace:*",
        "madge": "8.0.0",
        "@webpieces/rules-sdk": "workspace:*"
    },
    "peerDependencies": {
        "@nx/devkit": ">=18.0.0"
    },
    "author": "Dean Hiller",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/deanhiller/webpieces-ts.git",
        "directory": "packages/tooling/nx-webpieces-rules"
    },
    "publishConfig": {
        "bin": {
            "wp-design-visualize": "./src/scripts/wp-design-visualize.js"
        },
        "access": "public"
    },
    "devDependencies": {
        "@webpieces/tooling-testkit": "workspace:*"
    }
}
