{
    "name": "@webpieces/pr-gate",
    "version": "0.0.0-dev",
    "description": "Gated PR system: 3-point squash-merge, merge validation gate, and red/yellow/green PR dashboard. Standalone scripts, no Nx dependency required.",
    "type": "commonjs",
    "main": "./src/index.js",
    "bin": {
        "wp-finish-upsert-pr": "./bin/wp-finish-upsert-pr.js",
        "wp-start-upsert-pr": "./bin/wp-start-upsert-pr.js",
        "wp-start-update": "./bin/wp-start-update.js",
        "wp-finish-update": "./bin/wp-finish-update.js",
        "wp-cleanup": "./bin/wp-cleanup.js",
        "wp-land-pr": "./bin/wp-land-pr.js",
        "wp-check-pr": "./bin/wp-check-pr.js",
        "wp-review-upsert-pr": "./bin/wp-review-upsert-pr.js",
        "wp-push-dev": "./bin/wp-push-dev.js",
        "wp-finish-push-dev": "./bin/wp-finish-push-dev.js"
    },
    "files": [
        "src/**/*",
        "bin/**/*"
    ],
    "author": "Dean Hiller",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/deanhiller/webpieces-ts.git",
        "directory": "packages/tooling/pr-gate"
    },
    "dependencies": {
        "@webpieces/rules-config": "workspace:*",
        "@inversifyjs/binding-decorators": "1.1.5",
        "inversify": "7.10.4",
        "reflect-metadata": "0.2.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
