{
    "name": "http-client-core",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/http/http-client-core/src",
    "projectType": "library",
    "targets": {
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest run packages/http/http-client-core/"
            }
        },
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/packages/http/http-client-core",
                "main": "packages/http/http-client-core/src/index.ts",
                "tsConfig": "packages/http/http-client-core/tsconfig.lib.json",
                "assets": [
                    "packages/http/http-client-core/package.json",
                    "packages/http/http-client-core/README.md"
                ]
            }
        },
        "react-native-compat": {
            "executor": "nx:run-commands",
            "dependsOn": ["build", "^build"],
            "cache": true,
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/scripts/react-native-compat.ts",
                "{workspaceRoot}/packages/tooling/code-rules/src/react-native-compatibility.ts",
                "{workspaceRoot}/pnpm-lock.yaml"
            ],
            "options": {
                "command": "TS_NODE_PROJECT=tsconfig.base.json node -r @swc-node/register -r tsconfig-paths/register scripts/react-native-compat.ts http-client-core"
            }
        },
        "ci": {
            "dependsOn": [
                "lint",
                "build",
                "test",
                "react-native-compat",
                "architecture:validate-complete"
            ]
        }
    },
    "tags": ["framework:browser", "framework:node", "framework:react-native", "role:lib"]
}
