{
    "name": "ipc-server",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/core/ipc-server/src",
    "projectType": "library",
    "targets": {
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest run packages/core/ipc-server/"
            }
        },
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "outputPath": "dist/packages/core/ipc-server",
                "main": "packages/core/ipc-server/src/index.ts",
                "tsConfig": "packages/core/ipc-server/tsconfig.lib.json",
                "assets": [
                    "packages/core/ipc-server/package.json",
                    "packages/core/ipc-server/README.md"
                ]
            }
        },
        "react-native-compat": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "build",
                "^build"
            ],
            "cache": true,
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/scripts/react-native-compat.ts",
                "{workspaceRoot}/packages/tooling/code-rules/src/react-native-compatibility.ts",
                "{workspaceRoot}/pnpm-lock.yaml"
            ],
            "options": {
                "command": "TS_NODE_PROJECT=tsconfig.base.json node -r @swc-node/register -r tsconfig-paths/register scripts/react-native-compat.ts ipc-server"
            }
        },
        "ci": {
            "dependsOn": [
                "lint",
                "build",
                "test",
                "react-native-compat",
                "architecture:validate-complete"
            ]
        }
    },
    "tags": [
        "framework:browser",
        "framework:node",
        "role:lib",
        "framework:react-native"
    ]
}
