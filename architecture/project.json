{
    "name": "architecture",
    "root": "architecture",
    "projectType": "application",
    "targets": {
        "generate": {
            "executor": "nx:run-commands",
            "options": {
                "command": "TS_NODE_PROJECT=tsconfig.base.json node -r @swc-node/register -r tsconfig-paths/register scripts/wiring-source-generate.ts"
            }
        },
        "validate-architecture-unchanged": {
            "executor": "@webpieces/nx-source:validate-architecture-unchanged"
        },
        "validate-api-relations": {
            "executor": "@webpieces/nx-source:validate-api-relations"
        }
    },
    "tags": [
        "type:tooling",
        "role:app",
        "framework:node"
    ]
}
