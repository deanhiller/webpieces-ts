{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "namedInputs": {
        "default": ["{projectRoot}/**/*"],
        "production": [
            "default",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/.eslintrc.json",
            "!{projectRoot}/eslint.config.js"
        ],
        "rulesConfig": [
            "{workspaceRoot}/nx.json",
            "{workspaceRoot}/rules/project.json",
            "{workspaceRoot}/webpieces.config.json",
            "{workspaceRoot}/packages/tooling/nx-webpieces-rules/src/executors/validate-rules-config/**/*",
            "{workspaceRoot}/packages/tooling/rules-config/src/*config*.ts",
            "{workspaceRoot}/packages/tooling/rules-config/src/*schema*.ts",
            "{workspaceRoot}/packages/tooling/rules-config/src/default-rules.ts",
            "{workspaceRoot}/packages/tooling/rules-config/src/field-def.ts",
            "{workspaceRoot}/packages/tooling/rules-config/src/seed-entry.ts",
            "{workspaceRoot}/packages/tooling/rules-config/src/sections.ts",
            "{workspaceRoot}/packages/tooling/rules-config/src/types.ts"
        ]
    },
    "targetDefaults": {
        "@nx/js:tsc": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"],
            "cache": true
        },
        "test": {
            "cache": true,
            "inputs": ["default", "^default"]
        },
        "lint": {
            "inputs": [
                "default",
                "{workspaceRoot}/eslint.config.mjs",
                "{workspaceRoot}/architecture/dependencies.json"
            ],
            "cache": true,
            "options": {
                "quiet": true
            }
        },
        "@angular/build:application": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        }
    },
    "plugins": [
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            }
        },
        {
            "plugin": "@webpieces/nx-webpieces-rules",
            "options": {}
        }
    ]
}
